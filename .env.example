# Copy to .env, which is gitignored. A variable set in the shell wins over this file.
# Lines are KEY=value, without quotes.

# Maximum heart rate for HR zones and TRIMP. `garmin-runs --profile` shows Garmin's
# setting next to the highest values recorded on your runs.
DIGIRUN_HR_MAX=186

# DIGIRUN_OUT=./runs
# DIGIRUN_INTERVAL=3600
