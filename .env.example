# Copy to .env, which is gitignored. A variable set in the shell wins over this file.
# Lines are KEY=value, without quotes.

# Maximum heart rate for HR zones and TRIMP. `garmin-runs --profile` shows Garmin's
# setting next to the highest values recorded on your runs.
DIGIRUN_HR_MAX=186

# analyze.sh adds a satellite map to the HTML report, so the page holds your GPS
# positions and fetches imagery from EOX when opened. 0 leaves the map out.
# DIGIRUN_MAP=0

# Name routes in routes.txt in DIGIRUN_OUT, one `<activity id> = <name>` per line
# (analyze/README.md, Naming routes).

# DIGIRUN_OUT=./runs
# DIGIRUN_INTERVAL=3600
